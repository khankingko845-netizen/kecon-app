[Unit]
Description=KểCon staging — Next.js (next start)
After=kecon-supabase.service kecon-tunnel.service kecon-proxy.service
Wants=kecon-supabase.service kecon-tunnel.service kecon-proxy.service

[Service]
User=doppel
Environment=NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
ExecStart=/srv/kecon/current/deploy/prized/run-web.sh
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
